Page Scheduling Algorithm:

#include <stdio.h>
int main()
{
    int ref[] = {8,5,7,8,5,7,2,3,7,3,5,9,4,6,2};
    int n = 15, frames, f[10], faults = 0;
    int i, j, k, pos, far, found;

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    for(i = 0; i < frames; i++)
        f[i] = -1;

    printf("\nPage\tFrames\n");

    for(i = 0; i < n; i++) {
        found = 0;

        for(j = 0; j < frames; j++)
            if(f[j] == ref[i])
                found = 1;

        if(!found) {
            faults++;

            for(j = 0; j < frames; j++)
                if(f[j] == -1) {
                    pos = j;
                    break;
                }

            if(j == frames) {
                far = -1;
                pos = 0;

                for(j = 0; j < frames; j++) {
                    for(k = i + 1; k < n && f[j] != ref[k]; k++);
                    if(k > far) {
                        far = k;
                        pos = j;
                    }
                }
            }
            f[pos] = ref[i];
        }

        printf("%d\t", ref[i]);
        for(j = 0; j < frames; j++)
            printf("%d ", f[j]);
        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", faults);
    return 0;
}

