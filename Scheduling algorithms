                    currentTime += p[i].remainingTime;
                    p[i].remainingTime = 0;

                    p[i].completionTime = currentTime;

                    p[i].turnaroundTime =
                        p[i].completionTime -
                        p[i].arrivalTime;

                    p[i].waitingTime =
                        p[i].turnaroundTime -
                        p[i].burstTime;

                    completed++;
