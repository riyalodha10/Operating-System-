#include <stdio.h>
int main() 
{
    int ref[] = {3,5,7,2,5,1,2,3,1,3,5,3,1,6,2};
    int n = 15, frames, f[10], count[10];
    int i, j, pos, faults = 0, found, min;

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    for(i = 0; i < frames; i++) {
        f[i] = -1;
        count[i] = 0;
    }

    printf("\nPage\tFrames\n");

    for(i = 0; i < n; i++) {
        found = 0;

        for(j = 0; j < frames; j++) {
            if(f[j] == ref[i]) {
                found = 1;
                count[j] = i; // Counter method
                break;
            }
        }

        if(!found) {
            faults++;
            pos = -1;

            for(j = 0; j < frames; j++)
                if(f[j] == -1) {
                    pos = j;
                    break;
                }

            if(pos == -1) {
                min = count[0];
                pos = 0;

                for(j = 1; j < frames; j++)
                    if(count[j] < min) {
                        min = count[j];
                        pos = j;
                    }
            }

            f[pos] = ref[i];
            count[pos] = i;
        }

        printf("%d\t", ref[i]);
        for(j = 0; j < frames; j++)
            printf("%d ", f[j]);
        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", faults);
