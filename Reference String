FIFO:

#include <stdio.h>
int main() 
{
    int ref[] = {3,4,5,6,3,4,7,3,4,5,6,7,2,4,6};
    int n = 15, frames, f[10];
    int i, j, pos = 0, faults = 0, found;

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    for(i = 0; i < frames; i++)
        f[i] = -1;

    printf("\nPage\tFrames\n");

    for(i = 0; i < n; i++) {
        found = 0;

        for(j = 0; j < frames; j++)
            if(f[j] == ref[i])
                found = 1;

        if(!found) {
            f[pos] = ref[i];
            pos = (pos + 1) % frames;
            faults++;
        }

        printf("%d\t", ref[i]);
        for(j = 0; j < frames; j++)
            printf("%d ", f[j]);
        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", faults);
    return 0;
}

