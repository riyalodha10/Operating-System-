#include <stdlib.h>
#include <time.h>

struct Process
{
    int pid;
    int arrivalTime;
    int burstTime;
    int remainingTime;
    int completionTime;
    int turnaroundTime;
    int waitingTime;
};

int main()
{
    int n, quantum;
    int i;
    int currentTime = 0;
    int completed = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[n];

    for (i = 0; i < n; i++)
    {
        p[i].pid = i + 1;

        printf("\nEnter Arrival Time for P%d: ", i + 1);
        scanf("%d", &p[i].arrivalTime);

        printf("Enter First CPU Burst for P%d: ", i + 1);
        scanf("%d", &p[i].burstTime);
    }

    printf("\nEnter Time Quantum: ");
    scanf("%d", &quantum);

    srand(time(NULL));

    printf("\nRandomly generated next CPU bursts:\n");

    for (i = 0; i < n; i++)
    {
        int randomBurst = (rand() % 10) + 1;

        printf("P%d : First Burst = %d, Next Burst = %d\n",
               p[i].pid,
               p[i].burstTime,
               randomBurst);

