Page Scheduling Algorithm:

#include <stdio.h>
int main() {
int p[] = {8,5,7,8,5,7,2,3,7,3,5,9,4,6,2};
int f[10], n, i, j, k, pos, max, faults = 0;
printf("Enter frames: ");
scanf("%d", &n);
for(i=0;i<n;i++) f[i]=-1;
for(i=0;i<15;i++) {
int hit=0;
for(j=0;j<n;j++)
if(f[j]==p[i]) hit=1;
if(!hit) {
faults++;
for(j=0;j<n;j++)
if(f[j]==-1) break;
if(j==n) {
max=-1;
for(j=0;j<n;j++) {
for(k=i+1;k<15;k++)
if(f[j]==p[k]) break;
if(k>max) max=k, pos=j;
}
j=pos;
}
f[j]=p[i];
}
printf("%d : ",p[i]);
for(j=0;j<n;j++) printf("%d ",f[j]);
printf("\n");
}
printf("Page Faults = %d\n",faults);
return 0;
}




FIFO:

#include <stdio.h>
int main() {
int p[] = {3,4,5,6,3,4,7,3,4,5,6,7,2,4,6};
int f[10], n, i, j, k = 0, fault = 0, hit;
printf("Enter number of frames: ");
scanf("%d", &n);
for(i=0;i<n;i++) f[i] = -1;
for(i=0;i<15;i++) {
hit = 0;
for(j=0;j<n;j++)
if(f[j] == p[i]) hit = 1;
if(!hit) {
f[k] = p[i];
k = (k + 1) % n;
fault++;
}
printf("%d : ", p[i]);
for(j=0;j<n;j++)
printf("%d ", f[j]);
printf("\n");
}
printf("\nTotal Page Faults = %d\n", fault);
return 0;
}



LRU:

#include <stdio.h>
int main() {
int p[] = {3,5,7,2,5,1,2,3,1,3,5,3,1,6,2};
int f[10], c[10], n, i, j, x, min, pos, faults=0;
printf("Enter number of frames: ");
scanf("%d", &n);
for(i=0;i<n;i++) f[i]=-1;
for(i=0;i<15;i++) {
for(j=0;j<n;j++)
if(f[j]==p[i]) break;
if(j==n) {
faults++;
for(j=0;j<n;j++)
if(f[j]==-1) break;
if(j==n) {
min=c[0]; pos=0;
for(x=1;x<n;x++)
if(c[x]<min) min=c[x],pos=x;
j=pos;
}
f[j]=p[i];
}
c[j]=i;
printf("%d : ",p[i]);
for(x=0;x<n;x++)
printf("%d ",f[x]);
printf("\n");
}
printf("Total Page Faults = %d\n",faults);
return 0;
}




MFU:

#include <stdio.h>
int main() {
int p[] = {8,5,7,8,5,7,2,3,7,3,5,9,4,6,2};
int f[10], count[10] = {0};
int n, i, j, pos, max, fault = 0;
printf("Enter number of frames: ");
scanf("%d", &n);
for(i=0;i<n;i++) f[i] = -1;
for(i=0;i<15;i++) {
for(j=0;j<n;j++)
if(f[j] == p[i]) break;
if(j == n) {
fault++;
for(j=0;j<n;j++)
if(f[j] == -1) break;
if(j == n) {
max = count[0];
pos = 0;
for(j=1;j<n;j++)
if(count[j] > max)
max = count[j], pos = j;
j = pos;
}
f[j] = p[i];
count[j] = 1;
} else {
count[j]++;
}
printf("%d : ", p[i]);
for(j=0;j<n;j++)
printf("%d ", f[j]);
printf("\n");
}
printf("\nTotal Page Faults = %d\n", fault);
return 0;
}
